# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret string — protects the /api/ping-missing GET route used by
# Vercel Cron. Generate one with: openssl rand -hex 32
CRON_SECRET=your-random-secret

# Discord guild membership verification (server-only Vercel secrets)
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_BOT_TOKEN=your-discord-bot-token
